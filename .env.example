# Supabase Public Configuration (Required for client-side and server-side Supabase queries)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Optional: Supabase Service Role Key (Used strictly for server-side administrative tasks and migrations)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: AI Provider Key for AI Campus Assistant (Kept strictly server-side in API routes)
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key

# Optional: SMTP Settings for Email Utilities (lib/email-service.ts)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-smtp-username
EMAIL_PASSWORD=your-smtp-password
EMAIL_FROM="CampusOne IIIT Ranchi <no-reply@campusone.iiitranchi.ac.in>"
